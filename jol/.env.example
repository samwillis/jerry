# Operator configuration. Never commit .env.local or Neon credentials.
JOL_ORIGIN=http://127.0.0.1:8787
JOL_INSTANCE_ID=REPLACE_WITH_A_UUID_ONCE_PER_DEPLOYMENT
JOL_OAUTH_CLIENT_ID=REPLACE_WITH_REGISTERED_PUBLIC_CLIENT_ID
JOL_PHOTO_BUCKET=jol-photos
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://REPLACE_WITH_NEON_REALTIME_URL
NEON_REALTIME_SECRET=REPLACE_WITH_NEON_REALTIME_SECRET
# Neon injects AWS_* credentials into deployed Functions with bucket access.
