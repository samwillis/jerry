{
  "name": "jerry-on-line",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsx scripts/build.ts",
    "dev": "npm run build && node --env-file-if-exists=.env.local dist/local.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "preview": "JOL_PREVIEW_FIXTURE=1 vite build && tsx scripts/preview.ts",
    "check:hosted": "tsx --env-file=.env.local scripts/check-hosted.ts",
    "format": "prettier --write src web scripts/*.ts test neon*.ts vite.config.ts '!web/routeTree.gen.ts'"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^2.1.6",
    "@neon/auth": "^0.8.2",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.0",
    "@neon/realtime-tanstack": "^0.3.0",
    "@tanstack/react-db": "^1.0.0-rc.1.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@neon/config": "^1.13.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "neon": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
